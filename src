#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <HardwareSerial.h>

// --- PINS ---
#define LIGHT_PIN 18     // LED connected directly to GPIO 18
#define FAN_PIN 23       // Transistor for Fan

#define BT_RX 4          // HC-05 TXD
#define BT_TX 5          // HC-05 RXD

// --- OLED CONFIG ---
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

// --- OLED SLEEP TIMER VARIABLES ---
unsigned long lastActivityTime = 0;
bool screenAsleep = true; 
const unsigned long SLEEP_TIMEOUT = 60000; // 1 minute

// --- BLUETOOTH CONFIG ---
HardwareSerial BT(1);

void showHelloBuddy() {
  if (screenAsleep) {
    display.ssd1306_command(SSD1306_DISPLAYON); 
    screenAsleep = false;
  }
  lastActivityTime = millis(); 

  display.clearDisplay();
  display.setTextSize(2);      
  display.setTextColor(WHITE);
  display.setCursor(20, 15);   
  display.println("HELLO");
  display.setCursor(20, 35);
  display.println("BUDDY!");
  display.display();
}

void updateOLED(String line1, String line2) {
  if (screenAsleep) {
    display.ssd1306_command(SSD1306_DISPLAYON); 
    screenAsleep = false;
  }
  lastActivityTime = millis(); 

  display.clearDisplay();
  display.setTextSize(1);      
  display.setTextColor(WHITE);
  display.setCursor(0, 10);
  display.println(line1);
  display.println(line2);
  display.display();
}

void lightOn() {
  digitalWrite(LIGHT_PIN, HIGH); 
  updateOLED("CMD: LIGHT ON", "STATUS: SUCCESS");
}

void lightOff() {
  digitalWrite(LIGHT_PIN, LOW); 
  updateOLED("CMD: LIGHT OFF", "STATUS: SUCCESS");
}

void fanOn() {
  digitalWrite(FAN_PIN, HIGH); 
  updateOLED("CMD: FAN ON", "STATUS: SUCCESS");
}

void fanOff() {
  digitalWrite(FAN_PIN, LOW); 
  updateOLED("CMD: FAN OFF", "STATUS: SUCCESS");
}

void setup() {
    Serial.begin(115200);
    BT.begin(9600, SERIAL_8N1, BT_RX, BT_TX); 

    pinMode(LIGHT_PIN, OUTPUT);
    pinMode(FAN_PIN, OUTPUT);
    
    digitalWrite(LIGHT_PIN, LOW); 
    digitalWrite(FAN_PIN, LOW);  

    if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
      Serial.println("OLED failed");
      for(;;);
    }
    
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(WHITE);
    display.setCursor(0, 10);
    display.println("System Ready.");
    display.println("Going to sleep...");
    display.display();
    
    delay(2000); 
    
    display.ssd1306_command(SSD1306_DISPLAYOFF); 
    screenAsleep = true; 
}

void loop() {
    if (!screenAsleep && (millis() - lastActivityTime > SLEEP_TIMEOUT)) {
        display.ssd1306_command(SSD1306_DISPLAYOFF); 
        screenAsleep = true;
    }

    if (BT.available()) {
        String command = BT.readStringUntil('\n');
        command.trim(); 
        command.toLowerCase(); 
        
        if (command.indexOf("hello buddy") != -1 || command.indexOf("hello_buddy") != -1) {
            showHelloBuddy();
        }
        else if (command.indexOf("light on") != -1 || command.indexOf("light_on") != -1) {
            lightOn();
        }
        else if (command.indexOf("light off") != -1 || command.indexOf("light_off") != -1) {
            lightOff();
        }
        else if (command.indexOf("fan on") != -1 || command.indexOf("fan_on") != -1) {
            fanOn();
        }
        else if (command.indexOf("fan off") != -1 || command.indexOf("fan_off") != -1) {
            fanOff();
        }
    }
}
